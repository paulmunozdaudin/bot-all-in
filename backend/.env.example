# Football AI — environment variables
# Copy to .env and fill in. Never commit real values.

# --- Database ---
DATABASE_URL=postgresql+psycopg://football_ai:football_ai@localhost:5432/football_ai

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=info
API_V1_PREFIX=/api/v1
# Comma-separated origins allowed to call the API from a browser
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Data providers (Phase 2 — none of these are wired up yet) ---
# See docs/research/DATA_PROVIDERS.md for why each is chosen.
FOOTBALL_DATA_ORG_API_KEY=
SPORTMONKS_API_KEY=
API_FOOTBALL_API_KEY=
THE_ODDS_API_KEY=
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=

# --- LLM (explanation layer only — never generates probabilities) ---
ANTHROPIC_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
